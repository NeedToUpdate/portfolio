/.swc/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# serverless
.serverless/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vscode/
writing/
scratchpad/
# Content-hashed image twins and their .og.jpg cards. Build output of
# scripts/build-image-assets.mjs (npm run images), which runs before
# both `next dev` and `next build`.
/public/images/**/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].*
