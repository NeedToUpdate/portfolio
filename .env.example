# Every environment variable the site reads. Copy to .env for local
# deploys; nothing here is needed for `npm run dev`.

# --- Local development ---------------------------------------------------

# Comma-separated origins allowed to reach the dev server (e.g. a phone
# on the LAN: http://192.168.1.20:3000).
ALLOWED_DEV_ORIGINS=

# Canonical site URL for metadata, sitemap, and llms.txt.
# Defaults to https://artnikitin.dev. Set per stage by serverless.yml.
SITE_URL=

# --- Analytics (build time, inlined into the client bundle) ---------------

# PostHog project token. Leave empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# PostHog API host: the stage's own /relay path, e.g. https://dev.artnikitin.dev/relay.
NEXT_PUBLIC_POSTHOG_HOST=

# --- Deploy (read by serverless.<stage>.yml) -----------------------------

# Serverless Framework v4 access key, from the Serverless dashboard. Or
# run `npx serverless login` once instead.
SERVERLESS_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ACM certificates in us-east-1, one per stage.
DEV_CERTIFICATE_ARN=
PROD_CERTIFICATE_ARN=
# Basic auth for the dev stage. Both must be set or dev deploys open.
DEV_BASIC_AUTH_USERNAME=
DEV_BASIC_AUTH_PASSWORD=

# --- Set on the Lambda by serverless.yml; listed for reference -----------

# The basic-auth pair proxy.ts checks. Prod sets neither.
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=
# Bucket that holds the ISR cache under _cache/ (lib/isr-cache-handler.js).
# S3_CACHE_BUCKET_NAME=
# Region for the ISR cache client. Lambda sets it; defaults to us-east-1.
# AWS_REGION=
# Header Next uses for cache tags. Defaults to x-next-cache-tags.
# NEXT_CACHE_TAGS_HEADER=

# --- CI only (GitHub Actions provides these) -----------------------------

# GITHUB_TOKEN, GITHUB_REPOSITORY, GITHUB_STEP_SUMMARY: used by the
# CloudFront invalidation and IndexNow scripts after a deploy.
