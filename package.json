{
  "name": "portfolio",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "predev": "npm run images",
    "dev": "next dev",
    "build": "npm run images && next build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:smoke": "jest tests/smoke.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "start": "next start -p 4400",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/build-image-assets.mjs",
    "zip": "python scripts/zip_standalone.py",
    "deploy:dev": "npm run build && npm run zip && serverless deploy --stage dev",
    "deploy:prod": "npm run build && npm run zip && serverless deploy --stage prod"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.1.0",
    "next": "^16.4.6",
    "next-mdx-remote": "^6.0.0",
    "posthog-js": "^1.447.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.32",
    "serverless": "^4.46.0",
    "serverless-s3-sync": "^3.5.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "glob@>=9.0.0": "^14.0.5",
    "minimatch@>=7.0.0": "^11.0.8",
    "uuid": "^11.1.1"
  }
}
